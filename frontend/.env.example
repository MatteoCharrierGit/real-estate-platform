# Copia questo file in .env.production (build di produzione) o .env.local (sviluppo).
# .env.production NON va committato (vedi .gitignore). Le variabili VITE_* finiscono nel bundle: nessun segreto.
VITE_API_URL=https://<API_ID>.execute-api.eu-south-1.amazonaws.com
VITE_COGNITO_DOMAIN=https://<prefisso>.auth.eu-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<ID dell'app client della SPA>
VITE_COGNITO_REGION=eu-south-1
VITE_FILES_URL=https://files.mchaservice.tech
